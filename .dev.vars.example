# Copy to .dev.vars, which is git-ignored. Never commit real values.
# Do not use .env files for secrets: the OpenNext adapter copies them into the Worker.

# Runtime connection, used by `npm run dev`. On Cloudflare the Hyperdrive binding is used.
DATABASE_URL=""
# Direct connection (no "-pooler" in the host). Used by Prisma migrations.
DIRECT_DATABASE_URL=""

# Teamwork (Phase 3). Basic auth needs the site URL and an API key together.
# Site URL: your Teamwork address, e.g. https://rightleft.teamwork.com (no trailing slash).
TEAMWORK_BASE_URL=""
# API key: Teamwork > profile > Edit My Details > API & Mobile > API Token.
TEAMWORK_API_KEY=""

# Google sign-in (Better Auth). In Google Cloud, add the redirect URI
# <BETTER_AUTH_URL>/api/auth/callback/google to the OAuth client.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# This deployment's address, e.g. http://localhost:3000. No trailing slash.
BETTER_AUTH_URL=""
# Comma-separated emails that are always admins, so the first person can sign in.
AUTH_BOOTSTRAP_ADMINS=""

# Fluent Forms webhook (website leads). Fluent Forms sends it in the X-Webhook-Secret
# header; requests without it are rejected. Generate with: openssl rand -hex 32
FLUENT_FORMS_WEBHOOK_SECRET=
# Optional. The website's host, so its own pages are not counted as a referrer.
# LEADS_SITE_HOST=rightleftagency.com
